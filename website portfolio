    <!-- JAVASCRIPT FOR INTERACTIVITY -->
    <script>
        // Smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if(target) target.scrollIntoView({ behavior: 'smooth' });
            });
        });

        // Developer Photo Modal Controls
        function openImageModal() {
            document.getElementById('photo-modal').classList.remove('hidden');
        }

        function closeImageModal() {
            document.getElementById('photo-modal').classList.add('hidden');
        }

        // Music Player Simulation
        let isPlaying = false;
        function togglePlay() {
            const btn = document.getElementById('play-btn');
            const status = document.getElementById('player-status');
            const bar = document.getElementById('progress-bar');

            isPlaying = !isPlaying;

            if (isPlaying) {
                btn.innerText = "❚❚ PAUSE";
                btn.classList.replace('bg-yellow-400', 'bg-red-500');
                btn.classList.add('text-white');
                status.innerHTML = "<span>🔊</span> PLAYING: Track 01 - Portfolio.exe";
                bar.classList.add('playing-bar');
            } else {
                btn.innerText = "▶ PLAY ALBUM";
                btn.classList.replace('bg-red-500', 'bg-yellow-400');
                btn.classList.remove('text-white');
                status.innerHTML = "<span>▶</span> PAUSED: Track 01 - Portfolio.exe";
                bar.classList.remove('playing-bar');
            }
        }
    </script>
